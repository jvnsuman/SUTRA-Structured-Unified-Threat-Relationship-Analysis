 "documents": [
  {
   "doc_id": "h01",
   "text": "On 12/03/2026 complainant Smt. Sunita Devi r/o village Rampur stated that her daughter was taken by one Ramesh Sharma alias Bablu to Delhi in a white Maruti Swift DL8CAF5031."
  },
  {
   "doc_id": "h02",
   "text": "Accused Mohd. Irfan @ Guddu r/o Sector 14 Gurgaon was contacted on mob 98110-22334 and +91 9811022334."
  },
  {
   "doc_id": "h03",
   "text": "RAMESH SHARMA seen at bus stand Anand Vihar ISBT with unknown female. He was using number 9876501234."
  },
  {
   "doc_id": "h04",
   "text": "Deepak Verma transferred Rs 49,500 via UPI to Anil Kumar; suspect Anil Kumar is associated with Sai Placement Services Pvt Ltd."
  },
  {
   "doc_id": "h05",
   "text": "Bablu was traced on 9876501234 near Gorakhpur Bus Stand and later at Sonauli."
  },
  {
   "doc_id": "h06",
   "text": "Complainant Shri Ganesh Prasad stated that Mohammad Irfan alias Guddu demanded money and threatened him from phone 9811022334."
  },
  {
   "doc_id": "h07",
   "text": "Raju Kumar was seen near MG Road, phone 987-654-3210. Vehicle MH12AB1234 was parked outside Sunrise Traders Pvt Ltd."
  },
  {
   "doc_id": "h08",
   "text": "A call from Raju S. was traced to number 987-654-3210 at Shastri Nagar."
  },
  {
   "doc_id": "h09",
   "text": "Priya Sharma reported that Ramesh Verma of village Sultanpur contacted her on 9123456780."
  },
  {
   "doc_id": "h10",
   "text": "Informant stated that Ramesh Verma @ Chintu uses a Bolero UP32AB4567 and stays in Sector 22 Noida."
  },
  {
   "doc_id": "h11",
   "text": "Suresh Yadav, alias Sonu, was arrested at Kashmere Gate ISBT with a Tata tempo HR55AC1122; he works for Maa Durga Manpower Consultants."
  },
  {
   "doc_id": "h12",
   "text": "Sonu was seen again at Kashmere Gate ISBT and used SIM 9898989898."
  },
  {
   "doc_id": "h13",
   "text": "राजू कुमार को एमजी रोड पर देखा गया। मोबाइल नंबर ९८११०२२३३४ पर संपर्क हुआ।"
  },
  {
   "doc_id": "h14",
   "text": "शिकायतकर्ता सुनीता देवी ने बताया कि रमेश यादव उनकी बेटी को दिल्ली ले गया।"
  },
  {
   "doc_id": "h15",
   "text": "Raju Kumar of village Hariharpur, PS Thawe, district Gopalganj was questioned about a/c no 123456789012."
  },
  {
   "doc_id": "h16",
   "text": "SURESH YADAV ALIAS SONU WAS FOUND NEAR ANAND VIHAR ISBT ON MOBILE 9812345678."
  },
  {
   "doc_id": "h17",
   "text": "Complainant Kavita Singh stated that her sister went missing after meeting Mahesh Pandey, who called from 9700011122."
  },
  {
   "doc_id": "h18",
   "text": "Mahesh Pandey @ Golu operates from Sector 31 Gurgaon and runs Star Job Agency."
  },
  {
   "doc_id": "h19",
   "text": "The vehicle DL1CAB7788 registered to Vinod Rai was found at Raxaul."
  },
  {
   "doc_id": "h20",
   "text": "Vinod Rai paid Rs 45,000 to rahul@okaxis for arranging travel."
  }
 ],
